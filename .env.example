# 复制为 .env。PowerShell 服务环境变量优先于此文件。
# SQLite 必须在服务主机的持久本地目录，不要放在 NAS。Windows 路径建议加单引号。
NUXT_LIBRARY_DB_PATH=.data/library.sqlite
# 先手动建立媒体根目录。也可改为 NAS 的 UNC 路径（见 README）。
NUXT_LIBRARY_MEDIA_ROOT=media
# 毫秒。周期设为 0 时仅允许运行手动扫描。
NUXT_LIBRARY_SCAN_INTERVAL_MS=15000
NUXT_LIBRARY_STABLE_MS=8000
# 单视频上传上限（字节，默认 32 GiB）。
NUXT_LIBRARY_MAX_UPLOAD_BYTES=34359738368
# 可选：静态地址部署时，启用精确来源白名单。填写实际可访问的所有站点源，逗号分隔。
# NUXT_LIBRARY_ALLOWED_ORIGINS=http://192.168.1.20:3000,http://127.0.0.1:3000
# 内网 HTTP 使用 false；只在确实使用 HTTPS 时改为 true。
NUXT_LIBRARY_SECURE_COOKIES=false
# 默认仅本机可访问。局域网部署把地址改为 Windows 主机的局域网 IPv4，并限制防火墙。
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
# 初始化/重置管理员：pnpm admin:create --username admin（交互输入密码）。不要把密码写入此文件。
